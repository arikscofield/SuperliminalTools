<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GameVersion Condition="'$(GameVersion)' == ''">1.10.2023.2.17</GameVersion>
    <OutputPath>bin\$(GameVersion)\</OutputPath>
    <GameLibDir>$(MSBuildProjectDirectory)\GameLibs\$(GameVersion)</GameLibDir>
    <AssemblyName>$(GameVersion).superliminaltools</AssemblyName>
    <Product>SuperliminalToolsModern</Product>
    <Description>A plugin for Superliminal to allow the creation of tool-assisted speedruns.</Description>
    <OutputType>Library</OutputType>
    <IsPublishable>True</IsPublishable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <DefineConstants>$(DefineConstants);HAS_VO_PLAYER</DefineConstants>
    <DefineConstants Condition="'$(GameVersion)' == '1.10.2023.2.17'">$(DefineConstants);HAS_WARNING_CONTROLLER;HAS_INVERT_MULTIPLIER</DefineConstants>

    <!-- Build with the DebugProbes configuration (or /p:DebugProbes=true) to include
         PhysicsProbe (F9), DesyncLog and the determinism hit dump (F8). Off by
         default so releases ship no debug hotkeys. -->
    <Configurations>Debug;Release;DebugProbes</Configurations>
    <DebugProbes Condition="'$(Configuration)' == 'DebugProbes'">true</DebugProbes>
    <DebugProbes Condition="'$(DebugProbes)' == ''">false</DebugProbes>
    <DefineConstants Condition="'$(DebugProbes)' == 'true'">$(DefineConstants);DEBUG_PROBES</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugProbes'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Per-version list of approximate-reciprocal sites in UnityPlayer.dll,
       embedded so the shipped plugin carries no loose data files. -->
  <ItemGroup>
    <EmbeddedResource Include="CPUDeterminism\Sites\rsqrt_sites_$(GameVersion).txt" LogicalName="rsqrt_sites.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>$(PkgMoonSharp)\lib\net40-client\MoonSharp.Interpreter.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.35" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameLibDir)\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="Assembly-CSharp-firstpass">
			<HintPath>$(GameLibDir)\Assembly-CSharp-firstpass.dll</HintPath>
		</Reference>
		<Reference Include="Rewired_Core">
			<HintPath>$(GameLibDir)\Rewired_Core.dll</HintPath>
		</Reference>
		<Reference Include="Rewired_Windows">
			<HintPath>$(GameLibDir)\Rewired_Windows.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(GameLibDir)\UnityEngine.UI.dll</HintPath>
		</Reference>
	</ItemGroup>

  <Target Name="BuildAllVersions" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectFile)" Properties="GameVersion=1.10.2020.12.10;IsRecursiveBuild=true" Targets="Build" />
    <MSBuild Projects="$(MSBuildProjectFile)" Properties="GameVersion=1.10.2023.2.17;IsRecursiveBuild=true" Targets="Build" />
  </Target>

</Project>
